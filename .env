

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_key


CAPTION_IMAGES=true
TOP_K=6
MIN_SCORE=0.2
MAX_UPLOAD_MB=25

# OpenAI instead:
# LLM_PROVIDER=openai
# LLM_MODEL=<model name from your OpenAI dashboard>
# OPENAI_API_KEY=your-key-here

# Gemini instead:
# LLM_PROVIDER=gemini
# LLM_MODEL=<model name from Google AI Studio>
# GEMINI_API_KEY=your-key-here